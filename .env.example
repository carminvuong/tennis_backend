# Supabase Postgres connection string.
# Use the "Session pooler" (or "Transaction pooler") connection string from
# Supabase's Connect dialog, not the direct connection — Supabase's direct
# connection is IPv6-only, and Render's network is IPv4, so the direct string
# will fail to connect from the deployed backend.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres
